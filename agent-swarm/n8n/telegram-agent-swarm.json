    {
      "parameters": {
        "jsCode": "const out = $input.first().json;\nconst task = String($('Arahan').first().json.text || '').slice(0, 200);\nconst names = ['Mira','Hakim','Sara','Nadia','Danial','Rizq'];\nconst used = new Set();\nfor (const s of (out.intermediateSteps || [])) {\n  const t = String(s.action?.tool || '');\n  for (const n of names) if (t.includes(n)) used.add(n);\n}\nconst now = new Date().toISOString();\nconst reply = String(out.output || '').slice(0, 3900);\nconst rows = [{ masa: now, agent: 'Aina', status: 'Selesai', tugasan: task, ringkasan: reply.slice(0, 300) }];\nfor (const n of used) rows.push({ masa: now, agent: n, status: 'Selesai', tugasan: task, ringkasan: 'Dipanggil oleh Aina' });\nreturn rows.map((r, i) => ({ json: { ...r, reply: i === 0 ? reply : '' } }));"
      },
